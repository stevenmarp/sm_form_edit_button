<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Desktop buttons -->
    <t t-inherit="web.FormView.Buttons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_cp_buttons')]" position="inside">
            <button t-if="smCanShowEdit()" type="button"
                    class="btn btn-primary o_form_button_edit" data-hotkey="e"
                    t-on-click.stop="smEnableEdit">
                <i class="fa fa-pencil me-1"/>Edit
            </button>
        </xpath>
    </t>

    <!-- Mobile / Dialog buttons -->
    <t t-inherit="web.FormView" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='control-panel-create-button']" position="inside">
            <button t-if="smCanShowEdit()" type="button"
                    class="btn btn-primary o_form_button_edit" data-hotkey="e"
                    t-on-click.stop="smEnableEdit">
                <i class="fa fa-pencil me-1"/>Edit
            </button>
        </xpath>
    </t>
</templates>
