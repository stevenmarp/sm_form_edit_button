<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sm_form_edit_button.FormEditButton"
       t-inherit="web.FormView" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='control-panel-status-indicator']/t[@t-if='canEdit']"
               position="before">
            <button t-if="smCanShowEdit" type="button"
                    class="btn btn-primary o_form_button_edit"
                    data-hotkey="e" t-on-click.stop="() => this.smEnableEdit()">
                Edit
            </button>
        </xpath>
    </t>

</templates>
